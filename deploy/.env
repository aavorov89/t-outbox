# Single source of image versions for docker compose AND testcontainers (internal/testenv).
# Override any of them via environment variables of the same name.
POSTGRES_IMAGE=postgres:18.6-alpine
REDPANDA_IMAGE=redpandadata/redpanda:v26.2.6
JAEGER_IMAGE=jaegertracing/jaeger:2.22.0
# Build and runtime images of the app image (deploy/Dockerfile).
GO_IMAGE=golang:1.27.3-alpine
RUNTIME_IMAGE=gcr.io/distroless/static-debian12:nonroot
PROMETHEUS_IMAGE=prom/prometheus:v3.15.1
